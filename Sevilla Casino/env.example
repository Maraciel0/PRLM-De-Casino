# Postgres. On Vercel use the POOLED connection string.
DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=require"

# openssl rand -base64 48
AUTH_SECRET="change-me"
CSRF_SECRET="change-me-too"
CRON_SECRET="change-me-three"

# Comma-separated game handles that get the operator role
OPERATOR_HANDLES="yourhandle"

# Where players send deposits. Shown on the deposit screen.
HOUSE_ACCOUNT="house-account-handle"

APP_URL="http://localhost:3000"